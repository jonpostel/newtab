{
  "manifest_version": 3,
  "name": "Dark New Tab",
  "version": "1.3.0",
  "description": "深色主题新标签页，支持自定义网站、备份导入与加密存储。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
